---
import { t, type Locale } from '../lib/i18n'
import { imgUrl } from '../lib/sanity'

interface Props {
  value: any[]
  locale?: Locale
}

const { value, locale = 'zh' } = Astro.props

const videoEmbed = (url: string) => {
  const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/)
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`
  const bili = url.match(/bilibili\.com\/video\/(BV[\w]+)/)
  if (bili) return `https://player.bilibili.com/player.html?bvid=${bili[1]}&high_quality=1`
  const vimeo = url.match(/vimeo\.com\/(\d+)/)
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`
  return url
}

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')

/**
 * 渲染一行的行内 marks，返回 HTML 字符串（frontmatter 里不能写 JSX）。
 * 先套 decorator，最后再包 <a> —— 反过来会被内层标签覆盖掉链接。
 */
const renderInline = (block: any): string =>
  (block.children ?? [])
    .map((child: any) => {
      let html = esc(child.text ?? '')
      const marks: string[] = child.marks ?? []

      for (const mark of marks) {
        if (mark === 'strong') html = `<strong>${html}</strong>`
        else if (mark === 'em') html = `<em>${html}</em>`
        else if (mark === 'underline') html = `<u>${html}</u>`
        else if (mark === 'strike-through') html = `<s>${html}</s>`
        else if (mark === 'code') html = `<code>${html}</code>`
      }

      for (const mark of marks) {
        const def = (block.markDefs ?? []).find((d: any) => d._key === mark)
        if (def?._type === 'link' && def.href) {
          const target = def.blank ? ' target="_blank" rel="noopener noreferrer"' : ''
          html = `<a href="${esc(def.href)}"${target}>${html}</a>`
        }
      }

      return html
    })
    .join('')

/**
 * 把连续的 listItem 块聚合成一个 <ul>/<ol>。
 * 不能把每个块单独渲染成 <li> —— HTML 里 <li> 必须有 <ul>/<ol> 父元素，
 * 裸露的 <li> 会让浏览器各自猜语义，缩进和序号都会乱。
 */
type Segment =
  | { kind: 'single'; block: any }
  | { kind: 'list'; ordered: boolean; blocks: any[] }

const segments: Segment[] = []
for (const block of value ?? []) {
  const listItem = block?.listItem
  if (listItem === 'bullet' || listItem === 'number') {
    const ordered = listItem === 'number'
    const last = segments[segments.length - 1]
    if (last && last.kind === 'list' && last.ordered === ordered) {
      last.blocks.push(block)
    } else {
      segments.push({ kind: 'list', ordered, blocks: [block] })
    }
  } else {
    segments.push({ kind: 'single', block })
  }
}
---

{
  segments.map((seg) => {
    if (seg.kind === 'list') {
      const inner = seg.blocks.map((b) => `<li>${renderInline(b)}</li>`).join('')
      const tag = seg.ordered ? 'ol' : 'ul'
      return <Fragment set:html={`<${tag}>${inner}</${tag}>`} />
    }

    const block = seg.block

    if (block._type === 'block') {
      const style = block.style ?? 'normal'
      const inner = renderInline(block)
      const tag = style === 'h2' ? 'h2' : style === 'h3' ? 'h3' : style === 'blockquote' ? 'blockquote' : 'p'
      return <Fragment set:html={`<${tag}>${inner}</${tag}>`} />
    }

    if (block._type === 'imageWithAlt') {
      const caption = t(block.caption, locale)
      return (
        <figure>
          <img
            src={imgUrl(block, { w: 1200 })}
            srcset={[600, 900, 1200].map((w) => `${imgUrl(block, { w })} ${w}w`).join(', ')}
            sizes="(max-width:900px) 100vw, 72ch"
            alt={t(block.alt, locale)}
            loading="lazy"
            decoding="async"
          />
          {caption && <figcaption class="muted">{caption}</figcaption>}
        </figure>
      )
    }

    if (block._type === 'videoEmbed') {
      return (
        <figure class="video">
          <iframe
            src={videoEmbed(block.url)}
            title={t(block.caption, locale) || 'video'}
            frameborder="0"
            allowfullscreen
            loading="lazy"
          />
        </figure>
      )
    }

    if (block._type === 'callout') {
      return <aside class:list={['callout', block.tone ?? 'info']}>{t(block.body, locale)}</aside>
    }

    return null
  })
}

<style>
  :global(p) { margin: 0 0 1.1em; }
  :global(h2) { margin: 1.8em 0 .6em; }
  :global(h3) { margin: 1.5em 0 .5em; font-size: 17px; }
  :global(blockquote) {
    margin: 1.4em 0; padding-left: 18px; border-left: 2px solid var(--line);
    color: var(--muted); font-style: italic;
  }
  :global(ul), :global(ol) { margin: 0 0 1.1em; padding-left: 1.4em; }
  :global(li) { margin: .3em 0; }
  :global(figure) { margin: 1.8em 0; }
  :global(figure img) { width: 100%; border-radius: 2px; }
  :global(figcaption) { font-size: 13px; margin-top: 8px; }
  :global(.video) { position: relative; padding-bottom: 56.25%; height: 0; }
  :global(.video iframe) { position: absolute; inset: 0; width: 100%; height: 100%; }
  :global(.callout) {
    margin: 1.6em 0; padding: 14px 18px; font-size: 14px;
    border-left: 3px solid var(--line); background: #f7f7f4;
  }
  :global(.callout.warn) { border-left-color: #d9a441; background: #fdf8ec; }
  :global(.callout.success) { border-left-color: #5b9c6a; background: #f2f8f3; }
  :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .9em; background: #f2f2ef; padding: 1px 5px; border-radius: 3px;
  }
</style>
